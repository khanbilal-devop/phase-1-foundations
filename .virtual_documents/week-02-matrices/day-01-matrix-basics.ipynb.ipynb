import numpy as np

A = np.array([[1, 2],
              [3, 4]])

B = np.array([[3, 0],
              [1, 2]])

C = np.array([[1, 2, 3],
              [4, 5, 6]])

print("A:\n", A)
print("\nB:\n", B)
print("\nC:\n", C)


# Verify shapes

print("A.shape:", A.shape)
print("B.shape:", B.shape)
print("C.shape:", C.shape) 


print("A + B :\n", A+B)


# Matrix A and C cannot be added as these are of different shapes
try:
    print("A + C :\n", A+C)
except ValueError as e:
    print("Error : ",e)


print("A transpose:\n", np.transpose(A))

print("\nB transpose:\n", np.transpose(B))

print("\nC transpose:\n", np.transpose(C))


left_side  = (A + B).T
right_side = A.T + B.T

print("(A + B).T:\n", left_side)
print("\nA.T + B.T:\n", right_side)
print("\nEqual?", np.array_equal(left_side, right_side))


# Property 1: transposing twice gets you back to A
print("A:\n", A)
print("\n(A.T).T:\n", A.T.T)
print("Equal to A?", np.array_equal(A, A.T.T))

# Property 2: transpose of scalar multiple = scalar times transpose
left  = (3 * A).T
right = 3 * A.T
print("\n(3A).T equals 3*(A.T)?", np.array_equal(left, right))


# Applying learned concept in the field of ML and Quant

# 5 days of returns for 3 stocks: AAPL, MSFT, JPM
# Each row = one day, each column = one stock
returns = np.array([
    [ 0.010,  0.012, -0.003],   # Day 1
    [-0.005, -0.004,  0.008],   # Day 2
    [ 0.018,  0.015,  0.001],   # Day 3
    [ 0.003,  0.005, -0.002],   # Day 4
    [ 0.009,  0.008,  0.011],   # Day 5
])

print("Shape:", returns.shape)
print("Rows = days, Cols = stocks")
print(returns)


# Currently: each column is a stock
# After transpose: each row is a stock

stock_rows = returns.T
print("Transposed shape:", stock_rows.shape)
print("Rows = stocks, Cols = days")
print(stock_rows)

# Now iterate over stocks
stock_names = ['AAPL', 'MSFT', 'JPM']
for name, row in zip(stock_names, stock_rows):
    print(f"{name} returns: {row}")



